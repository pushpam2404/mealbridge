{
  "name": "mealbridge",
  "version": "1.0.0",
  "private": true,
  "description": "MealBridge: connect surplus food from restaurants and hostels with NGOs before it goes to waste.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/server.js",
    "dev:web": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "seed": "node --env-file-if-exists=.env server/scripts/seed.js",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env server/server.js",
    "dev:memory": "concurrently -n api,web -c green,cyan \"node server/scripts/seed-local.js\" \"npm:dev:web\"",
    "lint": "npm --prefix client run lint"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "author": "Pushpam Raj Satyarthi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pushpam2404/mealbridge.git"
  },
  "homepage": "https://mealbridge-app.vercel.app"
}
