# MongoDB connection string (MongoDB Atlas M0 free tier works fine)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mealbridge?retryWrites=true&w=majority
# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
# Optional: comma-separated list of allowed origins for the API (defaults to any)
# CORS_ORIGIN=https://mealbridge.vercel.app
# Optional: local API port (default 5050; macOS uses 5000 for AirPlay)
# PORT=5050
# Optional: true re-posts the demo kitchens' listings once they expire or are collected
# DEMO_MODE=true
